# Client (Vite) — required for the SPA
# Local Supabase (after `npm run supabase:start`):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<anon key printed by supabase start / status>
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-or-hosted-anon-key

# Hosted deploy target (Netlify env):
#   VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
#   VITE_SUPABASE_ANON_KEY=your-hosted-anon-key

# Enrichment function secrets (Netlify / `netlify dev` env)
# None are required for local demo — mock candidates are returned and labeled.
OMDB_API_KEY=
TMDB_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANIDB_CLIENT=
